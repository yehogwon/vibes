<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Widgets only run sandboxed. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Lets them read the moments the app keeps on this Mac. An app group would be the usual way,
	     but an ad hoc signature has no team to claim one with. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/Library/Application Support/Moments/</string>
	</array>
</dict>
</plist>
